# Server
PORT=5000
NODE_ENV=development

# PostgreSQL (user auth & sessions)
# Local Postgres example:
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=skillbridge
PG_USER=postgres
PG_PASSWORD=your_password
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=false

# Supabase Postgres example (replace with your actual password):
# PG_HOST=db.ddugeiukqfjhvncubduu.supabase.co
# PG_PORT=5432
# PG_DATABASE=postgres
# PG_USER=postgres
# PG_PASSWORD=[YOUR-PASSWORD]
# PG_SSL=true
# PG_SSL_REJECT_UNAUTHORIZED=false
# Optional fallback for an IPv4-compatible host when the primary host is IPv6-only:
# PG_HOST_IPV4=your.ipv4-db-host.example.com

# MongoDB (skills, forums, resources)
# Use a MongoDB Atlas connection string if you do not run Mongo locally.
# Example:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.b3bxqp0.mongodb.net/
MONGO_URI=mongodb://localhost:27017/skillbridge

# JWT
JWT_SECRET=supersecret123
JWT_EXPIRES_IN=7d

# OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Matching Engine
MATCHING_ENGINE_URL=http://localhost:8000

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Supabase
SUPABASE_URL=https://ddugeiukqfjhvncubduu.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_3U5BgSQ7B4h_vYSXBuk-Ew_jzoqathm
