# ============================================================
# SkillBridge backend — .env
# Copy to .env and fill in. Nothing here is a real secret.
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# The frontend's origin. THIS IS LIKELY YOUR #6 GOOGLE SIGN-IN BUG —
# if this is wrong or unset, the OAuth callback redirects nowhere
# usable and the user just lands on a broken page with no error shown.
CLIENT_URL=http://localhost:3000

# ── Databases ───────────────────────────────────────────────
# Postgres (Sequelize) — users, sessions, ratings, credits
DATABASE_URL=postgres://user:password@localhost:5432/skillbridge
# Individual PG_* vars are used as a fallback if DATABASE_URL isn't set —
# see config/database.js. Set one or the other, not both.
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=skillbridge
# PG_USER=postgres
# PG_PASSWORD=
# PG_SSL=false
# PG_SSL_REJECT_UNAUTHORIZED=true

# MongoDB (Mongoose) — skills, forum posts, messages, notifications, verification
MONGO_URI=mongodb://localhost:27017/skillbridge

# ── Auth ────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Google OAuth — required for "Continue with Google" to work at all.
# Get these from https://console.cloud.google.com/apis/credentials
#   1. Create an OAuth 2.0 Client ID (Web application)
#   2. Authorized redirect URI must EXACTLY match GOOGLE_CALLBACK_URL below
#      (protocol + host + port + path, no trailing slash mismatch)
#   3. If either GOOGLE_CLIENT_ID or GOOGLE_CLIENT_SECRET is missing,
#      the /auth/google routes return 501 instead of erroring at runtime
#      (see routes/authRoutes.js) — so a silent, permanent "doesn't work"
#      is expected if these are blank, not just an intermittent bug.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ── Video (Daily.co) ────────────────────────────────────────
# Dashboard → Developers → API keys: https://dashboard.daily.co
# Without this set, sessions still work but "Join" falls back to
# whatever external meetingLink (if any) the learner entered when booking —
# no in-app room is created. See services/dailyService.js.
DAILY_API_KEY=

# ── File uploads (Cloudinary) ───────────────────────────────
# Dashboard → https://cloudinary.com/console — all three come from the
# same "Product Environment Credentials" panel on your dashboard home.
# Powers skill/session materials (recordings, docs, images). Without these
# set, uploads return a clear 503 instead of failing silently.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Push notifications (optional) ──────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@skillbridge.app

# ── Matching engine ─────────────────────────────────────────
MATCHING_ENGINE_URL=http://localhost:8000

# ── AI skill-verification quizzes ──────────────────────────
ANTHROPIC_API_KEY=
