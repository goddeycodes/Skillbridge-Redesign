# ============================================================
# SkillBridge frontend — .env.local
# Copy to .env.local (Next.js only auto-loads that filename) and fill in.
# ============================================================

# Your backend API's base URL — INCLUDE the /api suffix.
# GoogleButton.jsx and the login/register pages both derive the OAuth URL
# from this var but strip /api differently in different places — worth
# double-checking both actually resolve to the same final URL once you
# set this, since that inconsistency was flagged as a possible contributor
# to unreliable Google sign-in.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Socket.io server — same host as the API, no /api suffix (raw origin).
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Web push public key — must match VAPID_PUBLIC_KEY on the backend exactly.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
